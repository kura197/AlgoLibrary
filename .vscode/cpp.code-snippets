    "Breadth-first search": {
        "scope": "cpp",
        "prefix": "bfs",
        "body": [
            "const ll INF = numeric_limits<ll>::max() / 4;",
            "vector<ll> dist(${1:n}, INF);",
            "queue<int> que;",
            "dist[s] = 0;",
            "que.emplace(s);",
            "while (!que.empty()) {",
            "    const auto v = que.front();",
            "    que.pop();",
            "    $0",
            "    for (const auto& [nv, _] : graph[v]) {",
            "        if (dist[nv] != INF) continue;",
            "        dist[nv] = dist[v] + 1;",
            "        que.emplace(nv);",
            "    }",
            "}"
        ],
        "description": "Run BFS and calculate unweighted distances"
    },
    "Dijkstra shortest path": {
        "scope": "cpp",
        "prefix": "dijkstra",
        "body": [
            "const ll INF = numeric_limits<ll>::max() / 4;",
            "vector<ll> dist(${1:n}, INF);",
            "minpq<pair<ll, int>> que;",
            "dist[s] = 0;",
            "que.emplace(0, s);",
            "while (!que.empty()) {",
            "    const auto [d, v] = que.top();",
            "    que.pop();",
            "    if (d != dist[v]) continue;",
            "    $0",
            "    for (const auto& [nv, cost] : graph[v]) {",
            "        const ll nd = d + cost;",
            "        if (dist[nv] <= nd) continue;",
            "        dist[nv] = nd;",
            "        que.emplace(nd, nv);",
            "    }",
            "}"
        ],
        "description": "Calculate shortest paths with Dijkstra's algorithm"
    },
    "Binary search on answer": {
        "scope": "cpp",
        "prefix": "bins",
        "body": [
            "auto condition = [&](ll x) -> bool {",
            "    return ${1:x >= 0};",
            "};",
            "ll ng = ${2:-1};",
            "ll ok = ${3:n};",
            "while (abs(ok - ng) > 1) {",
            "    const auto mid = ng + (ok - ng) / 2;",
            "    if (condition(mid))",
            "        ok = mid;",
            "    else",
            "        ng = mid;",
            "}",
            "$0"
        ],
        "description": "Find the minimum value satisfying a monotone condition"
    },
    "Ternary search on doubles": {
        "scope": "cpp",
        "prefix": [
            "ternary",
            "ternary_double"
        ],
        "body": [
            "auto objective = [&](double x) -> double {",
            "    return ${1:x * x};",
            "};",
            "double left = ${2:0.0};",
            "double right = ${3:1.0};",
            "rep(_, 100) {",
            "    const double mid1 = (2.0 * left + right) / 3.0;",
            "    const double mid2 = (left + 2.0 * right) / 3.0;",
            "    if (objective(mid1) ${4:<} objective(mid2))",
            "        right = mid2;",
            "    else",
            "        left = mid1;",
            "}",
            "const double x = (left + right) / 2.0;",
            "$0"
        ],
        "description": "Find an extremum of a unimodal function on a double interval"
    },
    "Ternary search on integers": {
        "scope": "cpp",
        "prefix": "ternary_int",
        "body": [
            "auto objective = [&](ll x) {",
            "    return ${1:x * x};",
            "};",
            "ll left = ${2:0};",
            "ll right = ${3:n};",
            "while (right - left > 2) {",
            "    const ll mid1 = left + (right - left) / 3;",
            "    const ll mid2 = right - (right - left) / 3;",
            "    if (objective(mid1) ${4:<} objective(mid2))",
            "        right = mid2;",
            "    else",
            "        left = mid1;",
            "}",
            "ll x = left;",
            "for (ll i = left + 1; i <= right; i++) {",
            "    if (objective(i) ${4:<} objective(x)) x = i;",
            "}",
            "$0"
        ],
        "description": "Find an extremum of a unimodal function on an inclusive integer interval"
    },
