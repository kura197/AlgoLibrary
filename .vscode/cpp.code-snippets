        "scope": "cpp",
        "prefix": "sum2d",
        "body": [
            "vector ${1:sum}(${2:a}.size() + 1, vector<ll>(${2:a}[0].size() + 1));",
            "rep(i, ${2:a}.size()) {",
            "    rep(j, ${2:a}[i].size()) {",
            "        ${1:sum}[i + 1][j + 1] = ${1:sum}[i + 1][j] + ${1:sum}[i][j + 1] - ${1:sum}[i][j] + ${2:a}[i][j];",
            "    }",
            "}",
            "$0"
        ],
        "description": "Build a two-dimensional prefix-sum table"
    },
