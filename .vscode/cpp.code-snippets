        "scope": "cpp",
        "prefix": "sum",
        "body": [
            "vector<ll> ${1:sum}(${2:a}.size() + 1);",
            "for (size_t i = 0; i < ${2:a}.size(); i++) ${1:sum}[i + 1] = ${1:sum}[i] + ${2:a}[i];",
            "$0"
        ],
        "description": "Build a prefix-sum vector"
    },
